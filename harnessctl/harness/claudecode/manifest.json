{
  "name": "claudecode",
  "version": "0.4.0",
  "protocol": "harnessctl/3",
  "entrypoint": "harnessctl",
  "platforms": [
    "linux"
  ],
  "requires": {
    "python": ">=3.9",
    "bin": [
      "claude"
    ]
  },
  "tested_backend_version": "2.1.316",
  "requests": [
    "permission",
    "question"
  ],
  "commands": [
    "init",
    "send",
    "cancel",
    "status",
    "reply"
  ],
  "stdin": [
    "send",
    "reply"
  ],
  "events": {
    "schema": "event.schema.json",
    "documentation": "EVENT.md",
    "types": [
      "accepted",
      "message",
      "request",
      "result",
      "log"
    ]
  }
}
